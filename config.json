{
  "_docs_1": "Defaults. Personal overrides go in config.local.json (gitignored) - any key there overrides the same key here WHOLESALE. The NTFY_TOPIC env var beats both (used by GitHub Actions secrets).",
  "_docs_2": "ATS slugs below were verified against live Summer2027 hardware postings (URL-mined from SimplifyJobs listings.json) and against zshah101's 4,054-board ATS registry. Slugs marked in _unverified_slugs are guesses - bad slugs only log a WARN and get skipped.",
  "_docs_3": "listings_repos roll over yearly (Summer2027 -> Summer2028). If one starts 404ing, check github.com/SimplifyJobs for the new repo name. Append :branch to override the default 'dev' branch.",
  "_docs_4": "exclude_keywords ships with defense contractors filtered out. Not your politics? Delete those lines in your fork.",
  "_docs_5": "IMPLEMENTED in watch.py + worker.js: include_terms (season filter on listing.terms; rows lacking a terms field are kept), require_active, exclude_companies (company-level blocklist), markdown_sources, atom_feeds, and a Workday adapter. keep() already falls back to keyword-only for sources with no category (e.g. vanshb03), so that source was never contributing zero.",

  "ntfy_topic": "CHANGE-ME-set-the-NTFY_TOPIC-secret",
  "max_alerts_per_run": 25,
  "max_age_days": 21,

  "require_active": true,
  "season_drop_terms": ["Fall 2026", "Summer 2026", "Spring 2026", "Winter 2026", "Spring 2027", "Winter 2027"],
  "season_a_terms": ["Summer 2027", "Summer 2028", "Fall 2027"],
  "season_title_drop": "summer 2026|fall 2026|spring 2026|winter 2026|2026 summer|spring 2027|winter 2027|\\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\s*(?:to|through|[-–—])\\s*(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)?[a-z]*\\.?,?\\s*20(?:2[0-6])\\b",
  "include_categories": ["Hardware", "Hardware Engineering"],
  "soft_categories": ["AI/ML/Data", "Data Science, AI & Machine Learning", "Software", "Software Engineering"],
  "tagged_subregex": "robot|perception|autonom|self-?driving|\\bAV\\b|\\bADAS\\b|\\bSLAM\\b|computer vision|embodied|manipulation|sensor|lidar|drone|\\bUAV\\b|vehicle|controls?|motion|edge|on-?device|embedded|hardware|firmware|inference|kernel|\\bCUDA\\b|compiler|accelerat",
  "tier_b_countries": ["canada", "united kingdom", "\\buk\\b", "england", "scotland", "ireland", "germany", "france", "spain", "italy", "netherlands", "sweden", "switzerland", "poland", "portugal", "austria", "belgium", "denmark", "finland", "norway", "czech", "japan"],
  "drop_countries": ["china", "\\bindia\\b", "singapore", "korea", "taiwan", "israel", "australia", "new zealand", "brazil", "mexico", "united arab emirates", "\\buae\\b", "saudi arabia", "\\bqatar\\b", "hong kong", "philippines", "vietnam", "thailand", "indonesia", "malaysia", "turkey", "egypt"],
  "_scoring_note": "Deviation from the +3/+2 in the prompt: hardware is +4 and robotics-software is +3 (both clear the Tier A >=3 bar on title alone, hardware still sorts higher). The written +3/+2 left robotics-software below the bar unless a fragile description fetch added +1, which failed the Zipline/Multiply recall test.",
  "scoring": [
    [4, "embedded|firmware|\\bhardware\\b|bring-?up|electronics design|board design|\\bPCB\\b|mechatronic|electrical engineer|hardware test|hardware validation|systems integration|schematic"],
    [3, "robot|\\bcontrols?\\b|autonom|perception|computer vision|sensor fusion|\\bSLAM\\b|\\bADAS\\b|edge (ai|ml|comput)|on-?device|flight software|3d vision|manipulation|\\bROS ?2?\\b|\\bvehicle\\b"],
    [1, "\\bC\\+\\+|\\bROS\\b|jetson|kicad|oscilloscope|logic analyzer|\\bI2C\\b|\\bSPI\\b|\\bUART\\b"],
    [-2, "\\bASIC\\b|\\bFPGA\\b|\\bRTL\\b|design verification|digital design|physical design|\\bVLSI\\b|\\banalog\\b|mixed-?signal|\\bRF\\b|photonic|power electronics|\\bbattery\\b|\\bthermal\\b|\\bmechanical\\b|manufacturing|materials"],
    [-3, "\\bPhD\\b|\\bMBA\\b"]
  ],
  "desc_hw_keywords": ["\\bPCB\\b", "\\bSoC\\b", "\\bSLAM\\b", "lidar", "radar", "sensor fusion", "\\bROS ?2?\\b", "kinematics", "microcontroller", "\\bMCU\\b", "\\bDSP\\b", "\\bCUDA\\b", "\\bTPU\\b", "motor control", "actuator", "bring-?up", "\\bHIL\\b", "signal integrity", "photonics", "schematic", "verilog", "\\bVHDL\\b", "\\bI2C\\b", "\\bSPI\\b", "\\bUART\\b", "\\bPWM\\b", "\\bRTOS\\b", "\\bFPGA\\b"],
